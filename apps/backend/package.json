{
	"name": "@envoy/backend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./router": {
			"types": "./dist/router.d.ts"
		}
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env.development src/server.ts",
		"typecheck": "tsc --noEmit",
		"build": "tsc",
		"start": "node --env-file=.env.production dist/server.js",
		"health": "node --env-file=.env.development dist/healthcheck.js",
		"health:prod": "node --env-file=.env.production dist/healthcheck.js",
		"test": "tsx --test test/*.test.ts"
	},
	"dependencies": {
		"@envoy/contracts": "workspace:*",
		"@trpc/server": "11.19.0",
		"openai": "^7.44.0",
		"sharp": "^0.35.5",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@trpc/client": "11.19.0",
		"@types/node": "22.20.5",
		"@types/ws": "8.18.2",
		"tsx": "4.23.15"
	}
}
